{
  "name": "shiftly-jobs-photos",
  "main": "index.mjs",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": { "ALLOWED_ORIGINS": "https://shiftlyapp.co.za" },
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "shiftly-jobs-test" }],
  "ratelimits": [{ "name": "UPLOAD_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }]
}
