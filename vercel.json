{
  "version": 2,
  "builds": [
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/login",
      "dest": "/public/login.html"
    },
    {
      "src": "/login/",
      "dest": "/public/login.html"
    },
    {
      "src": "/billing",
      "dest": "/public/billing.html"
    },
    {
      "src": "/billing/",
      "dest": "/public/billing.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
